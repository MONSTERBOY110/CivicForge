# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_FAST_MODEL / GEMINI_QUALITY_MODEL: Optional model overrides.
# FAST handles the high-volume per-grievance work (categorisation, the priority
# daemon, briefing translation). QUALITY handles only the funding blueprint, one
# call per MP authorisation. Free-tier request quota is per project PER MODEL, so
# pointing these at different models splits the load across separate buckets.
# Set FAST to "gemini-2.5-flash-lite" to cut cost further on the per-grievance work.
GEMINI_FAST_MODEL="gemini-2.5-flash"
GEMINI_QUALITY_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGO_URI: MongoDB Atlas connection string (Mongoose ODM). REQUIRED: the app
# throws on boot without it. Use an Atlas M0 (free) cluster to unlock 2dsphere
# geospatial queries + Atlas Vector Search (semantic grievance clustering).
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/civicforge"

# MONGO_DB_NAME: database name to use within the cluster (default: CivicForge).
# IMPORTANT: this must match the DB where your Atlas Vector Search index was created.
MONGO_DB_NAME="CivicForge"

# DNS_SERVERS: Optional. Resolvers used for the SRV lookup that `mongodb+srv://`
# requires (default: 8.8.8.8,1.1.1.1,9.9.9.9). Venue/hotspot Wi-Fi often answers
# SRV queries with REFUSED, which surfaces as "querySrv ECONNREFUSED".
DNS_SERVERS=""

# MONGO_URI_DIRECT: Optional escape hatch. A plain seed-list URI that needs NO DNS
# SRV lookup. Set it and the app connects straight to the hosts. If SRV resolution
# fails, the app resolves it over DNS-over-HTTPS and prints the exact line to paste
# here. Run `npm run db:check` to generate it.
# mongodb://user:pass@host-00:27017,host-01:27017,host-02:27017/CivicForge?authSource=admin&replicaSet=atlas-xxx-shard-0&tls=true
MONGO_URI_DIRECT=""

# JWT_SECRET: Secret key for JWT signing.
JWT_SECRET="super-secret-jwt-key-change-in-production"

# JWT_EXPIRES_IN: JWT expiry duration (e.g. 7d)
JWT_EXPIRES_IN="7d"

# OPENAI_API_KEY: Optional key for voice transcription via OpenAI Whisper.
OPENAI_API_KEY=""

# ELEVENLABS_API_KEY / ELEVENLABS_VOICE_ID: Optional. Enables spoken confirmations
# for citizens and the MP "Audio Briefing". If unset, voice features silently no-op
# (nothing breaks). Get a key + pick a voice id at https://elevenlabs.io.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# NODE_ENV: Environment mode (development or production)
NODE_ENV="development"


CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here